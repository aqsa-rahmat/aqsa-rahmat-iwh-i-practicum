doctype html
html
  head
    title= title
    link(rel="stylesheet", href="/css/style.css")
  body
    h1= title
    a(href="/update-cobj") Add to this table
    table
      thead
        tr
          th Name
          th Species
          th Care level
      tbody
        each plant in data
          tr
            td= plant.properties.name
            td= plant.properties.species
            td= plant.properties.care_level